# OpenSERP engine (Compose sets this automatically for the api service).
OPENSERP_BASE_URL=http://localhost:7000

# SDK request timeout in seconds. Mega search can take up to ~90s.
OPENSERP_TIMEOUT=120

# Optional. When set, /api/* requires Authorization: Bearer <key>.
API_KEY=

# Used by the FastAPI container / Railway.
PORT=8000
